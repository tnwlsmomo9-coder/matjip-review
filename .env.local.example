# Kakao Local API — get a REST API key from https://developers.kakao.com/console/app
# 1. Create an application in Kakao Developers console.
# 2. App Keys tab → copy the "REST API 키".
# 3. Platform settings → add your dev origin (http://localhost:3000) and your
#    production origin under Web platform, since Kakao enforces a domain
#    allowlist for browser-origin requests.
# 4. Copy this file to .env.local and paste the key below (never commit .env.local — already gitignored).
NEXT_PUBLIC_KAKAO_REST_API_KEY=

# Google Places API (New) — used server-side only (src/lib/google-places.ts,
# called from src/app/api/google-place-reviews/route.ts), so this is
# deliberately NOT prefixed with NEXT_PUBLIC_ and never reaches the browser.
# Enable "Places API (New)" for the key in Google Cloud Console.
GOOGLE_PLACES_API_KEY=

# Gemini API — used server-side only (src/lib/gemini.ts, called from
# src/app/api/analyze-reviews/route.ts) to analyze the fetched Google
# reviews, so this is also NOT prefixed with NEXT_PUBLIC_.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase — email/password auth (src/lib/supabase.ts, src/components/AuthProvider.tsx).
# Project Settings → API in the Supabase dashboard has both values. The
# publishable (anon) key is safe to expose to the browser like the Kakao key above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
